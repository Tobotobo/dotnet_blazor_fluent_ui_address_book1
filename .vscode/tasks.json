{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/AddressBookSys.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/AddressBookSys.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run PWA",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.PWA"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch PWA",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.PWA"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run Web",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.Web"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch Web",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.Web"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run WebAPI",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.WebAPI"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch WebAPI",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.WebAPI"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run WPF",
            "command": "dotnet",
            "type": "process",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.WPF"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch WPF",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/AddressBookSys.App.WPF"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "📤publish-maui-windows",
            "command": "dotnet",
            "type": "process",
            "args": [
              "publish",
              "-f",
              "net8.0-windows10.0.19041.0",
              "--self-contained",
              "${workspaceFolder}/AddressBookSys.App.MAUI",
              "/property:WindowsPackageType=None",
              "/property:GenerateFullPaths=true",
              "-o",
              "${workspaceFolder}/publish/AddressBookSys.App.MAUI-Windows"
            ],
            "problemMatcher": "$msCompile",
          },

    ]
}